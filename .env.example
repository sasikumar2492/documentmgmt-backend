DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BASE_PATH=Pharma+DMS

# ConvertAPI (doc→PDF, HTML→docx). Get secret at https://www.convertapi.com
CONVERT_API_SECRET=
CONVERT_API_BASE_URL=https://v2.convertapi.com

# Google Gemini (PDF→HTML). Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
