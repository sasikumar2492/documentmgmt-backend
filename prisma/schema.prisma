generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core identity and access models for Phase 1

model Organization {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true)
  departments Department[]
  users       User[]
  templates   DocumentTemplate[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id             String           @id @default(cuid())
  name           String
  code           String           @unique
  isActive       Boolean          @default(true)

  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String

  users          UserDepartment[]
  templates      DocumentTemplate[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  /// Machine‑readable key, e.g. "request.view"
  key         String           @unique
  description String?

  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  username       String?          /// Present if DB has this column (legacy/compat)
  passwordHash   String
  fullName       String
  isActive       Boolean          @default(true)

  organization   Organization?    @relation(fields: [organizationId], references: [id])
  organizationId String?

  roles          UserRole[]
  departments    UserDepartment[]
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  createdTemplates DocumentTemplate[] @relation("TemplateCreatedBy")

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDepartment {
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, departmentId])
}

/// Stateless JWT‑based auth is used for access tokens.
/// Refresh tokens are stored and can be rotated in later phases.
model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  /// Hashed random token value
  tokenHash String
  context   String?  /// e.g. "DMS" vs "TicketFlow"

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/// Password reset flow for /auth/forgot-password and /auth/reset-password
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  /// Hashed random token value
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Document Templates - Phase 1.3: Templates & AI-Assisted Document Preparation
model DocumentTemplate {
  id               String   @id @default(cuid())
  
  /// S3 storage details
  s3Bucket         String
  s3Key            String   /// Full S3 object key (path)
  originalFileName String
  fileSize         BigInt   /// File size in bytes
  mimeType         String   /// MIME type (e.g., application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
  
  /// Template metadata
  name             String?  /// Optional display name
  description      String?
  version          Int      @default(1)
  status           TemplateStatus @default(draft)
  
  /// Department association
  department       Department? @relation(fields: [departmentId], references: [id])
  departmentId     String?
  
  /// Organization association
  organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?
  
  /// AI-generated content (stored as JSON)
  parsedSections   Json?    /// AI-extracted sections/fields
  formSchema       Json?    /// Final form schema after AI conversion preview
  aiWorkflowProposal Json?   /// AI-generated workflow proposal
  
  /// Created/updated by
  createdBy        User     @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  createdById      String
  updatedById      String?
  
  /// Soft delete
  deletedAt       DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([departmentId])
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

enum TemplateStatus {
  draft
  pending_approval
  approved
  deprecated
}

